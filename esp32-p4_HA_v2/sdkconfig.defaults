CONFIG_IDF_TARGET="esp32p4"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Плата: ESP32-P4 rev 1.3, flash 16 МБ. Ревизии <3.0 и >=3.0 несовместимы, поэтому
# поддержка выбирается явно; 400 МГц на rev <3.0 недоступна (esp_clk_init assert).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# На плате стоит flash boya: без этой опции драйвер остаётся generic и сыплет
# предупреждением при каждом старте (см. docs/storage/MSTORE_BENCH.md:126-128).
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y

#
# Zigbee: стек на P4, радио — RCP на встроенном C6 (прошивка ot_rcp, spinel по UART).
# Перемычки на JP1: GPIO29 (TX) -> C6_U0RXD (pin 20), GPIO30 (RX) -> C6_U0TXD (pin 22).
#
CONFIG_ZB_ENABLED=y

#
# ESP-Hosted: Wi-Fi вынесен на отдельный сопроцессор ESP32-C3 по ESP-Hosted SPI.
# C6 несёт только 802.15.4 (ot_rcp), esp_hosted для Zigbee не нужен. Пресет платы
# (SDIO) отключён: с ним диапазон SPI-пинов залочен под другую разводку.
#
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_HOST_FEAT_RPC=y
CONFIG_ESP_HOSTED_HOST_FEAT_RPC_EXT_V2=y
CONFIG_ESP_HOSTED_HOST_FEAT_SYSTEM=y
CONFIG_ESP_HOSTED_HOST_FEAT_WIFI=y

# Web service: WebSocket на esp_http_server (docs/services/WEB.md).
CONFIG_HTTPD_WS_SUPPORT=y

# Сопроцессор Wi-Fi — ESP32-C3 (не встроенный C6): задаёт ожидаемый chip id и
# набор RPC. Без этого хост ждёт C6 (0x0d) и падает на "chip mismatch".
CONFIG_SLAVE_IDF_TARGET_ESP32C3=y

# C3 по SPI (mode 3). Пины P4 (все на гребёнке JP1) -> C3:
#   CLK32->CLK6  MOSI28->MOSI7  MISO33<-MISO5  CS31->CS10
#   HANDSHAKE49<-HS4  DATA_READY50<-DR3  EN34->C3 EN (сброс CP перед handshake).
# Скорость: 40 МГц (потолок C3-цели). Mode 3 обязателен на обоих концах (CP-дефолт).
# Периодический bring-up timeout был из-за отпаявшегося провода, не из-за частоты.
CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_SPI=y
CONFIG_ESP_HOSTED_HOST_SPI_CLK_GPIO=32
CONFIG_ESP_HOSTED_HOST_SPI_MOSI_GPIO=28
CONFIG_ESP_HOSTED_HOST_SPI_MISO_GPIO=33
CONFIG_ESP_HOSTED_HOST_SPI_CS_GPIO=31
CONFIG_ESP_HOSTED_HOST_HANDSHAKE_GPIO=49
CONFIG_ESP_HOSTED_HOST_DATA_READY_GPIO=50
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=34
CONFIG_ESP_HOSTED_HOST_SPI_CLK_MHZ=40
# Транзиентный провал bring-up (SPI-линк/гонка загрузки CP) не должен ронять Wi-Fi:
# при таймауте хост импульсом сбрасывает CP и повторяет bring-up.
CONFIG_ESP_HOSTED_HOST_CP_BRINGUP_ON_TIMEOUT_REATTEMPT=y

# PSRAM: кадровый буфер дисплея 480x800x2 = 768 КБ не влезает в internal.
CONFIG_SPIRAM=y

# SPI к C3: больше очереди, чтобы гасить всплески (Display/PSRAM).
CONFIG_ESP_HOSTED_HOST_SPI_TX_Q_SIZE=24
CONFIG_ESP_HOSTED_HOST_SPI_RX_Q_SIZE=24
