CONFIG_IDF_TARGET="esp32p4"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Плата: ESP32-P4 rev 1.3, flash 16 МБ. Ревизии <3.0 и >=3.0 несовместимы, поэтому
# поддержка выбирается явно; 400 МГц на rev <3.0 недоступна (esp_clk_init assert).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# На плате стоит flash boya: без этой опции драйвер остаётся generic и сыплет
# предупреждением при каждом старте (см. docs/storage/MSTORE_BENCH.md:126-128).
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y

#
# Zigbee: стек на P4, радио — RCP на встроенном C6.
#
CONFIG_ZB_ENABLED=y

#
# ESP-Hosted: SDIO несёт управление RCP, spinel (данные радио) — отдельный UART.
# UART между P4 и C6 на этой плате не распаян: перемычки на JP1
#   GPIO29 (TX) -> C6_U0RXD (pin 20), GPIO30 (RX) -> C6_U0TXD (pin 22).
#
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_HOST_FEAT_RPC=y
CONFIG_ESP_HOSTED_HOST_FEAT_RPC_EXT_V2=y
CONFIG_ESP_HOSTED_HOST_FEAT_SYSTEM=y
CONFIG_ESP_HOSTED_HOST_FEAT_OPENTHREAD=y
CONFIG_ESP_HOSTED_HOST_FEAT_OPENTHREAD_AUTO_INIT=y
CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_SDIO=y

# C6 несёт и Wi-Fi, и 802.15.4 RCP (CP собран с CP_FEAT_WIFI=y + FEAT_OPENTHREAD=y).
# Хостовый Wi-Fi-слой (esp_wifi_remote) работает поверх ESP-Hosted по SDIO.
CONFIG_ESP_HOSTED_HOST_FEAT_WIFI=y

# Web service: WebSocket на esp_http_server (docs/services/WEB.md).
CONFIG_HTTPD_WS_SUPPORT=y

# Платы с такой распиновкой SDIO (CMD19 / CLK18 / D0-D3 = 14-17, reset GPIO54).
CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y

CONFIG_ESP_HOSTED_OT_HOST_TRANSPORT_UART=y
CONFIG_ESP_HOSTED_OT_HOST_UART_PORT=1
CONFIG_ESP_HOSTED_OT_HOST_UART_TX_PIN_TO_RCP=29
CONFIG_ESP_HOSTED_OT_HOST_UART_RX_PIN_TO_RCP=30
CONFIG_ESP_HOSTED_OT_HOST_UART_BAUDRATE=460800

# Совместимость набора возможностей 802.15.4 с RCP (как в примере esp_hosted).
CONFIG_OPENTHREAD_RX_ON_WHEN_IDLE=n
