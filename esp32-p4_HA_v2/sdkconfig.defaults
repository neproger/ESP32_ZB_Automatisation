CONFIG_IDF_TARGET="esp32p4"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Плата: ESP32-P4 rev 1.3, flash 16 МБ. Ревизии <3.0 и >=3.0 несовместимы, поэтому
# поддержка выбирается явно; 400 МГц на rev <3.0 недоступна (esp_clk_init assert).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# На плате стоит flash boya: без этой опции драйвер остаётся generic и сыплет
# предупреждением при каждом старте (см. docs/storage/MSTORE_BENCH.md:126-128).
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y

#
# Zigbee: стек на P4, радио — RCP на встроенном C6 (прошивка ot_rcp, spinel по UART).
# Перемычки на JP1: GPIO29 (TX) -> C6_U0RXD (pin 20), GPIO30 (RX) -> C6_U0TXD (pin 22).
#
CONFIG_ZB_ENABLED=y

#
# ESP-Hosted: Wi-Fi вынесен на отдельный сопроцессор ESP32-C3 (UART). C6 несёт только
# 802.15.4 (ot_rcp), esp_hosted для Zigbee не нужен. Пресет платы (SDIO) отключён:
# с ним диапазон UART-пинов жёстко = 14.
#
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_HOST_FEAT_RPC=y
CONFIG_ESP_HOSTED_HOST_FEAT_RPC_EXT_V2=y
CONFIG_ESP_HOSTED_HOST_FEAT_SYSTEM=y
CONFIG_ESP_HOSTED_HOST_FEAT_WIFI=y

# Web service: WebSocket на esp_http_server (docs/services/WEB.md).
CONFIG_HTTPD_WS_SUPPORT=y

# Сопроцессор Wi-Fi — ESP32-C3 (не встроенный C6): задаёт ожидаемый chip id и
# набор RPC. Без этого хост ждёт C6 (0x0d) и падает на "chip mismatch".
CONFIG_SLAVE_IDF_TARGET_ESP32C3=y

# C3 по UART2: P4 GPIO32 (TX) -> C3 GPIO4 (RX); P4 GPIO28 (RX) <- C3 GPIO5 (TX).
# Reset: P4 GPIO34 -> C3 EN (кнопка RST) — хост сбрасывает CP перед ожиданием
# handshake, иначе CP отдаёт caps раньше, чем хост начал слушать (гонка загрузки).
# 115200: на 921600 handshake не проходит, на 460800 Wi-Fi нестабилен (проверено).
CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_UART=y
CONFIG_ESP_HOSTED_HOST_UART_PORT=2
CONFIG_ESP_HOSTED_HOST_UART_TX_GPIO=32
CONFIG_ESP_HOSTED_HOST_UART_RX_GPIO=28
CONFIG_ESP_HOSTED_HOST_UART_BAUD=115200
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=34
