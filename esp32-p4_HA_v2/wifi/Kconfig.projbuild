menu "Wi-Fi service"

    config WIFI_SSID
        string "Wi-Fi SSID (bring-up seed)"
        default ""
        help
            Точка доступа для автоподключения, если список известных сетей пуст.
            Значение задаётся в sdkconfig (не в git); в будущем — через provisioning
            (Display/Web). Владелец радио — сервис wifi, поэтому креды живут здесь.

    config WIFI_PASSWORD
        string "Wi-Fi password"
        default ""

endmenu
