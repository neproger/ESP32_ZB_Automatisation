# Rust often needs a bit of an extra main task stack size compared to C (the default is 3K)
# You might have to increase this further if you allocate large stack variables in the main task
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Increase a bit these stack sizes as they are also a bit too small by default
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096

# You might have to increase this further if you spawn your own Rust threads 
# that allocate large stack variables; or better yet - use 
# `std::thread::Builder::new().stack_size(XXX)` for spawning
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# Логи в USB-Serial/JTAG, иначе консоль уходит в UART0.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set

# P4 на этой плате — rev v1.3 (pre-v3.0): нестандартный CLIC, иначе illegal instruction.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP32P4_REV_MIN_FULL=100

# Zigbee: стек на P4, радио — ot_rcp на C6 по UART (как в V2).
CONFIG_ZB_ENABLED=y
CONFIG_ZB_ZCZR=y
CONFIG_ZB_RADIO_SPINEL_UART=y

CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_HOST_FEAT_RPC=y
CONFIG_ESP_HOSTED_HOST_FEAT_RPC_EXT_V2=y
CONFIG_ESP_HOSTED_HOST_FEAT_SYSTEM=y
CONFIG_ESP_HOSTED_HOST_FEAT_WIFI=y
# C3 ?? SPI (mode 3), ?? ?? ?????, ??? ? V2: HANDSHAKE49/DR50/EN34,
# CLK32/MOSI28/MISO33/CS31.
CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_SPI=y
CONFIG_ESP_HOSTED_HOST_SPI_CLK_GPIO=32
CONFIG_ESP_HOSTED_HOST_SPI_MOSI_GPIO=28
CONFIG_ESP_HOSTED_HOST_SPI_MISO_GPIO=33
CONFIG_ESP_HOSTED_HOST_SPI_CS_GPIO=31
CONFIG_ESP_HOSTED_HOST_HANDSHAKE_GPIO=49
CONFIG_ESP_HOSTED_HOST_DATA_READY_GPIO=50
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=34
CONFIG_ESP_HOSTED_HOST_SPI_CLK_MHZ=40
CONFIG_ESP_HOSTED_HOST_CP_BRINGUP_ON_TIMEOUT_REATTEMPT=y
CONFIG_ESP_HOSTED_HOST_SPI_TX_Q_SIZE=24
CONFIG_ESP_HOSTED_HOST_SPI_RX_Q_SIZE=24
CONFIG_ESP_HOSTED_HOST_DEFLT_TASK_PRIORITY=5
# ?????? dev-board ?????????? SPI-???? ??? ?????? ???????? ? ???????? GPIO14/15
# (??? Spinel UART ? C6). ???? ???????? ???? ????.
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
# CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD is not set
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C3=y
# CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6 is not set
# Slave target ???????? esp_wifi_remote; ?? ???? ?? ??????? ESP_HOSTED_CP_TARGET_*.
CONFIG_SLAVE_IDF_TARGET_ESP32C3=y
# CONFIG_SLAVE_IDF_TARGET_ESP32C6 is not set
# HTTP-??????: WebSocket ??? /ws.
CONFIG_HTTPD_WS_SUPPORT=y
# Wi-Fi remote (C3) buffers: V2 used larger RX/TX pools and BA windows; the
# defaults (10/32/32/6) were less stable on the same hardware.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_TX_BA_WIN=16
CONFIG_ESP_WIFI_RX_BA_WIN=16
CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=16
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_WIFI_RMT_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_WIFI_RMT_TX_BA_WIN=16
CONFIG_WIFI_RMT_RX_BA_WIN=16

# Display (порт V2): кадровый буфер DSI 480x800x2 = 768 КБ не влезает в internal.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
# LVGL 9 (managed-компонент): RGB565 и 8 стопов градиента для цветного виджета.
CONFIG_LV_COLOR_FORMAT_RGB565=y
CONFIG_LV_COLOR_DEPTH=16
CONFIG_LV_GRADIENT_MAX_STOPS=8

# esp_lcd/esp_lcd_touch тянут legacy-драйвер i2c вместе с esp_driver_i2c.
# Используется только новый драйвер, поэтому стартовый конфликт-чек выключаем.
CONFIG_I2C_SKIP_LEGACY_CONFLICT_CHECK=y
